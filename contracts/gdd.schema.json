{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-agent-factory/contracts/gdd.schema.json",
  "title": "游戏设计文档 (GDD)",
  "description": "程序智能体的唯一输入。包含玩法描述、关卡配置、三强类型数值表。",
  "type": "object",
  "required": ["game_title", "genre", "core_loop", "levels", "numeric_tables"],
  "additionalProperties": false,
  "properties": {
    "game_title": {
      "type": "string",
      "minLength": 1,
      "description": "游戏标题"
    },
    "genre": {
      "type": "string",
      "minLength": 1,
      "description": "游戏类型，如 platformer/tower-defense/puzzle"
    },
    "core_loop": {
      "type": "string",
      "minLength": 1,
      "description": "核心玩法循环的自然语言描述"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "description": "关卡列表，至少一关",
      "items": {
        "type": "object",
        "required": ["level_id", "name", "difficulty", "spawn_table"],
        "additionalProperties": false,
        "properties": {
          "level_id": {
            "type": "string",
            "pattern": "^lvl_[0-9]{2}$",
            "description": "关卡 ID，格式 lvl_00 / lvl_01"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "关卡名称"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "难度 1-10"
          },
          "spawn_table": {
            "type": "array",
            "description": "实体生成表，每项描述一个生成点",
            "items": {
              "type": "object",
              "required": ["entity_id", "asset_id", "position", "count"],
              "additionalProperties": false,
              "properties": {
                "entity_id": {"type": "string", "description": "实体实例 ID"},
                "asset_id": {"type": "string", "description": "引用资产清单中的 asset_id"},
                "position": {
                  "type": "object",
                  "required": ["x", "y", "z"],
                  "description": "生成坐标",
                  "properties": {
                    "x": {"type": "number"},
                    "y": {"type": "number"},
                    "z": {"type": "number"}
                  }
                },
                "count": {"type": "integer", "minimum": 1, "description": "生成数量"}
              }
            }
          }
        }
      }
    },
    "numeric_tables": {
      "type": "object",
      "description": "三强类型数值表，程序智能体直接消费生成 GDScript 数值逻辑",
      "required": ["schema_version", "damage", "economy", "growth"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "description": "数值表结构版本号，变更时递增"
        },
        "damage": {
          "type": "object",
          "description": "伤害表",
          "required": ["entries"],
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unit_id", "base", "growth_per_level", "cooldown"],
                "additionalProperties": false,
                "properties": {
                  "unit_id": {"type": "string", "description": "单位 ID"},
                  "base": {"type": "number", "minimum": 0, "description": "基础伤害"},
                  "growth_per_level": {"type": "number", "description": "每级伤害增量"},
                  "cooldown": {"type": "number", "minimum": 0, "description": "冷却时间(秒)"}
                }
              }
            }
          }
        },
        "economy": {
          "type": "object",
          "description": "经济表",
          "required": ["entries"],
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["resource", "initial", "per_wave", "cost_cap"],
                "additionalProperties": false,
                "properties": {
                  "resource": {"type": "string", "description": "资源名称，如 gold/wood"},
                  "initial": {"type": "number", "minimum": 0, "description": "初始数量"},
                  "per_wave": {"type": "number", "description": "每波产出"},
                  "cost_cap": {"type": "number", "minimum": 0, "description": "消耗上限"}
                }
              }
            }
          }
        },
        "growth": {
          "type": "object",
          "description": "成长表",
          "required": ["entries"],
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unit_id", "hp_curve", "unlock_level"],
                "additionalProperties": false,
                "properties": {
                  "unit_id": {"type": "string", "description": "单位 ID"},
                  "hp_curve": {
                    "type": "array",
                    "items": {"type": "number"},
                    "description": "HP 曲线，下标对应等级"
                  },
                  "unlock_level": {"type": "integer", "minimum": 1, "description": "解锁等级"}
                }
              }
            }
          }
        }
      }
    }
  }
}