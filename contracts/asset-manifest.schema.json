{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-agent-factory/contracts/asset-manifest.schema.json",
  "title": "资产清单 (Asset Manifest)",
  "description": "所有游戏资产的清单。dependencies[] 须构成 DAG（由 validators.validate_no_circular_deps 校验）。",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "array",
      "minItems": 1,
      "description": "资产列表",
      "items": {
        "type": "object",
        "required": ["asset_id", "type", "target_scene", "dependencies", "status"],
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "description": "资产 ID，须符合 art-spec.naming_pattern"
          },
          "type": {
            "type": "string",
            "enum": ["model", "texture", "ui", "audio", "anim"],
            "description": "资产类型"
          },
          "target_scene": {
            "type": "string",
            "minLength": 1,
            "description": "归属场景名称"
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "依赖的 asset_id 列表，须构成 DAG（无环）"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_review", "delivered", "rejected"],
            "description": "资产状态"
          },
          "npot": {
            "type": "boolean",
            "default": false,
            "description": "是否为 NPOT（非 2 的幂）尺寸资产。仅 type=ui 时可置 true 走豁免。"
          }
        }
      }
    }
  }
}