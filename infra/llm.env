# LLM 接入配置（混合模式）
# 本地：Ollama OpenAI 兼容接口，跑 Windows 原生不进容器
# 云端：公有 API 做策划文档与代码生成

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# 模型分流
MODEL_DESIGNER=cloud
MODEL_SUPERVISOR=cloud
MODEL_CODER=cloud
MODEL_ARTIST3D=qwen3.5:4b
MODEL_ARTIST2D=qwen3.5:4b
MODEL_QA=qwen3.5:2b

# 云端 API（通过环境变量注入，不写入此文件）
# LLM_CLOUD_PROVIDER=glm | deepseek | qwen
# LLM_CLOUD_API_KEY=sk-xxx
# LLM_CLOUD_BASE_URL=https://open.bigmodel.cn/api/paas/v4